# 复制本文件为 .env 并填入你自己的值（.env 已被 .gitignore 忽略，不会提交）
#   cp .env.example .env

# Gemini API Key（必填）
GEMINI_API_KEY=your_api_key_here

# 代理设置（可选，三态）
#   不设置 / 注释掉： 自动走系统代理——陆区命中系统 SOCKS/HTTP 代理，海外无代理则直连
#   指定代理：        http://127.0.0.1:7897 （socks5://… 亦可）
#   强制直连：        none （忽略系统代理，直接连 Gemini）
# GEMINI_PROXY=http://127.0.0.1:7897
